{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCard",
  "version": "0.3.1",
  "identifier": "cn.origenclub.ocard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OCard",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNjQyODlDQjlBQjEwNEYKUldSUEVLdTVuQ2hrY0tPcXVPbVgyWGJ2dm0xcmZwVmUvUC9oK2dYQVYxYW9yNzdHR0tMRVFUY2sK",
      "endpoints": [
        "https://github.com/hanbin2007/OCard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["resources/models/*"],
    "linux": {
      "deb": {
        "depends": ["fonts-noto-cjk"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
