{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and welcome windows",
  "windows": ["main", "welcome"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
